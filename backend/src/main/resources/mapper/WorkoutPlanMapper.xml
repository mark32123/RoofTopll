<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ll.rooftopll.mapper.WorkoutPlanMapper">

    <resultMap id="WorkoutPlanResultMap" type="com.ll.rooftopll.entity.WorkoutPlan">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="name" column="name"/>
        <result property="description" column="description"/>
        <result property="createdAt" column="created_at"/>
        <collection property="activities" ofType="com.ll.rooftopll.entity.WorkoutPlanActivity"
                    select="com.ll.rooftopll.mapper.WorkoutPlanActivityMapper.findByPlanId" column="id"/>
    </resultMap>

    <select id="findByUserId" resultMap="WorkoutPlanResultMap">
        SELECT * FROM workout_plan WHERE user_id = #{userId}
    </select>

    <select id="findById" resultMap="WorkoutPlanResultMap">
        SELECT * FROM workout_plan WHERE id = #{planId}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO workout_plan (user_id, name, description, created_at) VALUES (#{userId}, #{name}, #{description}, NOW())
    </insert>

    <update id="update">
        UPDATE workout_plan SET name = #{name}, description = #{description} WHERE id = #{id}
    </update>

    <delete id="delete">
        DELETE FROM workout_plan WHERE id = #{planId}
    </delete>

</mapper>
