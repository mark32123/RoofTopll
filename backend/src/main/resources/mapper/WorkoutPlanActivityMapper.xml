<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ll.rooftopll.mapper.WorkoutPlanActivityMapper">

    <resultMap id="WorkoutPlanActivityResultMap" type="com.ll.rooftopll.entity.WorkoutPlanActivity">
        <id property="id" column="id"/>
        <result property="planId" column="plan_id"/>
        <result property="exerciseId" column="exercise_id"/>
        <result property="orderNum" column="order_num"/>
        <collection property="sets" ofType="com.ll.rooftopll.entity.WorkoutPlanSet"
                    select="com.ll.rooftopll.mapper.WorkoutPlanSetMapper.findByActivityId" column="id"/>
    </resultMap>

    <select id="findByPlanId" resultMap="WorkoutPlanActivityResultMap">
        SELECT * FROM workout_plan_activity WHERE plan_id = #{planId} ORDER BY order_num
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO workout_plan_activity (plan_id, exercise_id, order_num) VALUES (#{planId}, #{exerciseId}, #{orderNum})
    </insert>

    <delete id="deleteByPlanId">
        DELETE FROM workout_plan_activity WHERE plan_id = #{planId}
    </delete>

</mapper>
